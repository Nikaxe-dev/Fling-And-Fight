; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fling And Fight"
config/version="1.0"
run/main_scene="uid://dgr38pghxvmmd"
config/use_custom_user_dir=true
config/custom_user_dir_name="nikaxe/fling_and_fight"
config/features=PackedStringArray("4.7", "4.7.1", "4.7.1", "C#", "GL Compatibility")
config/icon="uid://2gbmis67qj5w"

[autoload]

ConsoleUI="*uid://dh2x5lnklpc14"
NetworkManager="*uid://cgq7ve731rqrt"
GameManager="*uid://c3d02dtcnj37x"
MouseInputManager="*uid://co4ciphoaek5d"
InputManager="*uid://bmdpo8fxmmerv"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Fling And Fight"

[editor_plugins]

enabled=PackedStringArray("res://addons/func_godot/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Data/": "red",
"res://addons/": "gray",
"res://trenchbroom/": "gray"
}

[filesystem]

import/blender/enabled=false
import/blender/enabled.web=true

[global_group]

UIModal="If enabled, while the control node is visible, the mouse will not be locked unless the right mouse button is down."

