; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fling And Fight*"
config/version="1.0"
run/main_scene="uid://dgr38pghxvmmd"
config/features=PackedStringArray("4.7", "4.7.1", "4.7.1", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*uid://cgq7ve731rqrt"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Fling And Fight"

[editor_plugins]

enabled=PackedStringArray("res://addons/func_godot/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Assets/Meshes/": "red",
"res://Assets/Models/": "red",
"res://Assets/Sounds/": "red",
"res://Content/": "green",
"res://Game/": "blue",
"res://Launcher/": "yellow",
"res://Scenes/": "green",
"res://Scripts/": "blue"
}

[filesystem]

import/blender/enabled=false
import/blender/enabled.web=true

