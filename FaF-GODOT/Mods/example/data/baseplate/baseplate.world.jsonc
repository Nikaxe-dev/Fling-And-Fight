{
    "Name": "Baseplate",
    "Description": "Baseplate world included in the example pack",

    "Creator": "Nikaxe",

    // links to a map in the map registry with the identifier 'baseplate:main'
    "MainMap": "baseplate:main",

    // include the content of these namespaces when loading the world
    "Include": [
        "faf",
        "new_sedes"
    ],

    // exclude the content of these namespaces when loading the world
    "Exclude": [
        "nuke_mod",
        "malware_number_1378845365"
    ]

    // include & exclude cannot be present at the same time
    // if none are specified then all namespaces are loaded
}