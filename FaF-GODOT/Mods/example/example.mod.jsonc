/*
.json / .jsonc is supported for data files
data file names are formatted like so: [DATA_ID].[OPTIONAL_MERGE_TYPE].[CONTENT_TYPE].[json/jsonc]
example: grabline.gear.json, faf.pack.json, new_sedes.world.json

.example.merge.json -> merged with other declarations in the same namespace
.example.overwrite.json -> overwrites other declarations in the same namespace

.pack.json -> pack data

.world.json -> world data
    inside the root directory of a mod
    allows for the mod to be loaded as a world in game
    contains data about which mods to include / exclude from loading when the world is loaded into
    also what scene to load into the tree when loading

.gear.json -> gear data
    inside the /data/gears directory of a mod
    contains data about a gear like the scene to load and shop info

.prop.json -> prop data
    inside the /data/props directory of a mod
    contains data about a prop like the scene to load and shop info

*/

{
    // this stops the pack from loading or initalizing entirely
    "_DISABLED": true,

    "Name": "Example Pack",
    "Description": "An example pack for FaF. Have fun modding!",

    "Creator": "nikaxe",

    "Links": {
        "Contact": "mailto:nikaxe.public@gmail.com",

        "Source": "https://github.com/nikaxe-dev/fling-and-fight/tree/main/FaF-GODOT/Mods/example",
        "Issues": "https://github.com/nikaxe-dev/fling-and-fight/issues",

        "Discord": "https://discord.gg/vhpYZGUvXx"
    },

    "VersionName": "The foo and bar update",

    // version only contains the major minor and patch
    "Version": "1.0.0",

    // mods required for this mod to work
    // formatted as Mod ID: Version Requirement
    "Dependencies": {
        // requires faf, version 0.0.0 or above
        "faf": ">=0.0.0",

        // a space between requirements means and
        // so this would mean somewhere between version 0.1.0 or 1.0.0 of some_mod
        "some_mod": ">=0.1.0 <=1.0.0",

        // '|' between requirements means or
        // so this would be version 0.0.0 or 0.1.0 of some_other_mod
        "some_other_mod": "0.0.0|0.1.0",

        // an empty string means any version of the namespace works
        "some_other_other_mod": "any"

        // the recommended version of a dependency given to a user is the highest one available matching the requirements
    }
}