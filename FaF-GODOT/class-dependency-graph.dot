digraph CSharpDependencies {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, splines=sprite, overlap=false, nodesep=0.2, ranksep=0.8];
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  subgraph "cluster_Fling And Fight" {
    label="Fling And Fight (net8.0)";
    style="filled";
    color="lightgray";

    "Fling And Fight.FaFLogger" [label="FaFLogger", fillcolor=white, tooltip="FaF.Debug.FaFLogger"];
    "Fling And Fight.NodeSingleton" [label="NodeSingleton", fillcolor=white, tooltip="FaF.NodeSingleton"];
    "Fling And Fight.ProgramEntry" [label="ProgramEntry", fillcolor=white, tooltip="FaF.ProgramEntry"];
    "Fling And Fight.Game" [label="Game", fillcolor=white, tooltip="FaF.Services.Game"];
    "Fling And Fight.InputService" [label="InputService", fillcolor=white, tooltip="FaF.Services.InputService"];
    "Fling And Fight.MouseInputService" [label="MouseInputService", fillcolor=white, tooltip="FaF.Services.MouseInputService"];
    "Fling And Fight.NetworkService" [label="NetworkService", fillcolor=white, tooltip="FaF.Services.NetworkService"];
    "Fling And Fight.RunService" [label="RunService", fillcolor=white, tooltip="FaF.Services.RunService"];
  }

  "Fling And Fight.ProgramEntry" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.NetworkService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.InputService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.MouseInputService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.RunService" [penwidth=1.5];
  "Fling And Fight.MouseInputService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.NetworkService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
}
