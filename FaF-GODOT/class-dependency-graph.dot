digraph CSharpDependencies {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, splines=sprite, overlap=false, nodesep=0.2, ranksep=0.8];
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  // Cycle highlighting
  edge [color="#FF0000", penwidth=2.0];


  subgraph "cluster_Fling And Fight" {
    label="Fling And Fight (net8.0)";
    style="filled";
    color="lightgray";

    "Fling And Fight.ClientInstance" [label="ClientInstance", fillcolor=white, tooltip="FaF.Client.ClientInstance"];
    "Fling And Fight.ClientNetworkService" [label="ClientNetworkService", fillcolor=white, tooltip="FaF.Client.Services.ClientServices.ClientNetworkService"];
    "Fling And Fight.GameInstance" [label="GameInstance", fillcolor=white, tooltip="FaF.Core.GameInstance"];
    "Fling And Fight.Logger" [label="Logger", fillcolor=white, tooltip="FaF.Core.Lib.Debug.Logger"];
    "Fling And Fight.LoggerFactory" [label="LoggerFactory", fillcolor=white, tooltip="FaF.Core.Lib.Debug.LoggerFactory"];
    "Fling And Fight.FSInstance" [label="FSInstance", fillcolor=white, tooltip="FaF.Core.Lib.FileSystem.FSInstance"];
    "Fling And Fight.FileInstance" [label="FileInstance", fillcolor=white, tooltip="FaF.Core.Lib.FileSystem.FileInstance"];
    "Fling And Fight.FileAccessGetFileAsStringFailed" [label="FileAccessGetFileAsStringFailed", fillcolor=white, tooltip="FaF.Core.Lib.FileSystem.FileAccessGetFileAsStringFailed"];
    "Fling And Fight.FileReadJsonFailed" [label="FileReadJsonFailed", fillcolor=white, tooltip="FaF.Core.Lib.FileSystem.FileReadJsonFailed"];
    "Fling And Fight.FolderInstance" [label="FolderInstance", fillcolor=white, tooltip="FaF.Core.Lib.FileSystem.FolderInstance"];
    "Fling And Fight.Program" [label="Program", fillcolor=white, tooltip="FaF.Core.Program"];
    "Fling And Fight.ProgramArgNotGivenException" [label="ProgramArgNotGivenException", fillcolor=white, tooltip="FaF.Core.ProgramArgNotGivenException"];
    "Fling And Fight.ContentResource" [label="ContentResource", fillcolor=white, tooltip="FaF.Core.Resources.ContentResources.ContentResource"];
    "Fling And Fight.ItemLikeResource" [label="ItemLikeResource", fillcolor=white, tooltip="FaF.Core.Resources.ContentResources.ItemLikeResource"];
    "Fling And Fight.ModResource" [label="ModResource", fillcolor=white, tooltip="FaF.Core.Resources.ContentResources.ModResource"];
    "Fling And Fight.PackResource" [label="PackResource", fillcolor=white, tooltip="FaF.Core.Resources.ContentResources.PackResource"];
    "Fling And Fight.WorldResource" [label="WorldResource", fillcolor=white, tooltip="FaF.Core.Resources.ContentResources.WorldResource"];
    "Fling And Fight.NetworkService" [label="NetworkService", fillcolor=white, tooltip="FaF.Core.Services.AbstractServices.NetworkService"];
    "Fling And Fight.AssetService" [label="AssetService", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.AssetService"];
    "Fling And Fight.AssetNotFoundException" [label="AssetNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.AssetNotFoundException"];
    "Fling And Fight.AssetFileNotFoundException" [label="AssetFileNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.AssetFileNotFoundException"];
    "Fling And Fight.AssetFileIsWrongTypeException" [label="AssetFileIsWrongTypeException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.AssetFileIsWrongTypeException"];
    "Fling And Fight.ContentService" [label="ContentService", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.ContentService"];
    "Fling And Fight.PackNotFoundException" [label="PackNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.PackNotFoundException"];
    "Fling And Fight.ModNotFoundException" [label="ModNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.ModNotFoundException"];
    "Fling And Fight.WorldNotFoundException" [label="WorldNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.WorldNotFoundException"];
    "Fling And Fight.PropNotFoundException" [label="PropNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.PropNotFoundException"];
    "Fling And Fight.GearNotFoundException" [label="GearNotFoundException", fillcolor=white, tooltip="FaF.Core.Services.ProgramServices.GearNotFoundException"];
    "Fling And Fight.Service" [label="Service", fillcolor=white, tooltip="FaF.Core.Services.Service"];
    "Fling And Fight.ServerInstance" [label="ServerInstance", fillcolor=white, tooltip="FaF.Server.ServerInstance"];
    "Fling And Fight.ServerNetworkService" [label="ServerNetworkService", fillcolor=white, tooltip="FaF.Server.Services.ServerServices.ServerNetworkService"];
  }

  "Fling And Fight.ClientInstance" -> "Fling And Fight.GameInstance" [penwidth=1.5];
  "Fling And Fight.ClientInstance" -> "Fling And Fight.LoggerFactory" [penwidth=1.5];
  "Fling And Fight.ClientInstance" -> "Fling And Fight.ClientNetworkService" [penwidth=1.5];
  "Fling And Fight.ClientNetworkService" -> "Fling And Fight.NetworkService" [penwidth=1.5];
  "Fling And Fight.LoggerFactory" -> "Fling And Fight.Logger" [penwidth=1.5];
  "Fling And Fight.FSInstance" -> "Fling And Fight.FolderInstance" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.FSInstance" -> "Fling And Fight.FileInstance" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.FileInstance" -> "Fling And Fight.FSInstance" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.FileInstance" -> "Fling And Fight.FileAccessGetFileAsStringFailed" [penwidth=1.5];
  "Fling And Fight.FileInstance" -> "Fling And Fight.FileReadJsonFailed" [penwidth=1.5];
  "Fling And Fight.FolderInstance" -> "Fling And Fight.FSInstance" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.FolderInstance" -> "Fling And Fight.FileInstance" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.Program" -> "Fling And Fight.ProgramArgNotGivenException" [penwidth=1.5];
  "Fling And Fight.Program" -> "Fling And Fight.LoggerFactory" [penwidth=1.5];
  "Fling And Fight.Program" -> "Fling And Fight.AssetService" [penwidth=1.5];
  "Fling And Fight.Program" -> "Fling And Fight.ContentService" [penwidth=1.5];
  "Fling And Fight.Program" -> "Fling And Fight.ServerInstance" [penwidth=1.5];
  "Fling And Fight.Program" -> "Fling And Fight.ClientInstance" [penwidth=1.5];
  "Fling And Fight.ContentResource" -> "Fling And Fight.FileInstance" [penwidth=1.5];
  "Fling And Fight.ContentResource" -> "Fling And Fight.FolderInstance" [penwidth=1.5];
  "Fling And Fight.ItemLikeResource" -> "Fling And Fight.ContentResource" [penwidth=1.5];
  "Fling And Fight.ModResource" -> "Fling And Fight.ContentResource" [penwidth=1.5];
  "Fling And Fight.ModResource" -> "Fling And Fight.ContentService" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.ModResource" -> "Fling And Fight.WorldResource" [penwidth=1.5];
  "Fling And Fight.PackResource" -> "Fling And Fight.ItemLikeResource" [penwidth=1.5];
  "Fling And Fight.WorldResource" -> "Fling And Fight.ItemLikeResource" [penwidth=1.5];
  "Fling And Fight.NetworkService" -> "Fling And Fight.LoggerFactory" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetNotFoundException" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetFileIsWrongTypeException" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetFileNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.Service" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.PackNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.ModNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.WorldNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.PackResource" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.ModResource" [penwidth=1.5, color="#FF0000", penwidth=2.0, fontcolor="#FF0000", label="cycle"];
  "Fling And Fight.ContentService" -> "Fling And Fight.WorldResource" [penwidth=1.5];
  "Fling And Fight.Service" -> "Fling And Fight.ServerInstance" [penwidth=1.5];
  "Fling And Fight.Service" -> "Fling And Fight.ClientInstance" [penwidth=1.5];
  "Fling And Fight.ServerInstance" -> "Fling And Fight.GameInstance" [penwidth=1.5];
  "Fling And Fight.ServerInstance" -> "Fling And Fight.LoggerFactory" [penwidth=1.5];
  "Fling And Fight.ServerInstance" -> "Fling And Fight.ServerNetworkService" [penwidth=1.5];
  "Fling And Fight.ServerNetworkService" -> "Fling And Fight.NetworkService" [penwidth=1.5];
}
