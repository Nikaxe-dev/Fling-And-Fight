digraph CSharpDependencies {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, splines=sprite, overlap=false, nodesep=0.2, ranksep=0.8];
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  subgraph "cluster_Fling And Fight" {
    label="Fling And Fight (net8.0)";
    style="filled";
    color="lightgray";

    "Fling And Fight.FaFLogger" [label="FaFLogger", fillcolor=white, tooltip="FaF.Debug.FaFLogger"];
    "Fling And Fight.ProgramEntry" [label="ProgramEntry", fillcolor=white, tooltip="FaF.ProgramEntry"];
    "Fling And Fight.AssetService" [label="AssetService", fillcolor=white, tooltip="FaF.Services.Content.AssetService"];
    "Fling And Fight.AssetNotFoundException" [label="AssetNotFoundException", fillcolor=white, tooltip="FaF.Services.Content.AssetNotFoundException"];
    "Fling And Fight.AssetFileNotFoundException" [label="AssetFileNotFoundException", fillcolor=white, tooltip="FaF.Services.Content.AssetFileNotFoundException"];
    "Fling And Fight.AssetFileIsWrongTypeException" [label="AssetFileIsWrongTypeException", fillcolor=white, tooltip="FaF.Services.Content.AssetFileIsWrongTypeException"];
    "Fling And Fight.ContentService" [label="ContentService", fillcolor=white, tooltip="FaF.Services.Content.ContentService"];
