    "Fling And Fight.ModNotFoundException" [label="ModNotFoundException", fillcolor=white, tooltip="FaF.Services.Content.ModNotFoundException"];
    "Fling And Fight.WorldNotFoundException" [label="WorldNotFoundException", fillcolor=white, tooltip="FaF.Services.Content.WorldNotFoundException"];
    "Fling And Fight.ContentResource" [label="ContentResource", fillcolor=white, tooltip="FaF.Services.Content.Resources.ContentResource"];
    "Fling And Fight.ItemLikeResource" [label="ItemLikeResource", fillcolor=white, tooltip="FaF.Services.Content.Resources.ItemLikeResource"];
    "Fling And Fight.ModResource" [label="ModResource", fillcolor=white, tooltip="FaF.Services.Content.Resources.ModResource"];
    "Fling And Fight.WorldResource" [label="WorldResource", fillcolor=white, tooltip="FaF.Services.Content.Resources.WorldResource"];
    "Fling And Fight.Game" [label="Game", fillcolor=white, tooltip="FaF.Services.Game"];
    "Fling And Fight.NetworkService" [label="NetworkService", fillcolor=white, tooltip="FaF.Services.Lifecycle.NetworkService"];
    "Fling And Fight.RunService" [label="RunService", fillcolor=white, tooltip="FaF.Services.Lifecycle.RunService"];
    "Fling And Fight.ModLoader" [label="ModLoader", fillcolor=white, tooltip="FaF.Services.Modding.ModLoaders.ModLoader"];
    "Fling And Fight.ModService" [label="ModService", fillcolor=white, tooltip="FaF.Services.Modding.ModService"];
    "Fling And Fight.PackLoader" [label="PackLoader", fillcolor=white, tooltip="FaF.Services.Modding.PackLoaders.PackLoader"];
    "Fling And Fight.PackService" [label="PackService", fillcolor=white, tooltip="FaF.Services.Modding.PackService"];
    "Fling And Fight.Service" [label="Service", fillcolor=white, tooltip="FaF.Services.Service"];
    "Fling And Fight.ServiceLoader" [label="ServiceLoader", fillcolor=white, tooltip="FaF.Services.ServiceLoader"];
    "Fling And Fight.InputService" [label="InputService", fillcolor=white, tooltip="FaF.Services.UserInput.InputService"];
    "Fling And Fight.MouseInputService" [label="MouseInputService", fillcolor=white, tooltip="FaF.Services.UserInput.MouseInputService"];
    "Fling And Fight.Player" [label="Player", fillcolor=white, tooltip="FaF.Services.World.Player"];
    "Fling And Fight.PlayerService" [label="PlayerService", fillcolor=white, tooltip="FaF.Services.World.PlayerService"];
    "Fling And Fight.WorldRoot" [label="WorldRoot", fillcolor=white, tooltip="FaF.Services.World.WorldRoot"];
    "Fling And Fight.WorldService" [label="WorldService", fillcolor=white, tooltip="FaF.Services.World.WorldService"];
    "Fling And Fight.FreeCamera" [label="FreeCamera", fillcolor=white, tooltip="FaF.Visuals.Camera.FreeCamera"];
  }

  "Fling And Fight.ProgramEntry" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetNotFoundException" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetFileIsWrongTypeException" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.AssetFileNotFoundException" [penwidth=1.5];
  "Fling And Fight.AssetService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.PackNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.ModNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.WorldNotFoundException" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.ModResource" [penwidth=1.5];
  "Fling And Fight.ContentService" -> "Fling And Fight.WorldResource" [penwidth=1.5];
  "Fling And Fight.ItemLikeResource" -> "Fling And Fight.ContentResource" [penwidth=1.5];
  "Fling And Fight.ModResource" -> "Fling And Fight.ContentResource" [penwidth=1.5];
  "Fling And Fight.WorldResource" -> "Fling And Fight.ItemLikeResource" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.NetworkService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.InputService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.MouseInputService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.RunService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.WorldService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.PlayerService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.ModService" [penwidth=1.5];
  "Fling And Fight.Game" -> "Fling And Fight.ContentService" [penwidth=1.5];
  "Fling And Fight.NetworkService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.PackService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.Service" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.ServiceLoader" -> "Fling And Fight.Service" [penwidth=1.5];
  "Fling And Fight.MouseInputService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.PlayerService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.PlayerService" -> "Fling And Fight.Player" [penwidth=1.5];
  "Fling And Fight.WorldRoot" -> "Fling And Fight.FreeCamera" [penwidth=1.5];
  "Fling And Fight.WorldService" -> "Fling And Fight.FaFLogger" [penwidth=1.5];
  "Fling And Fight.WorldService" -> "Fling And Fight.WorldRoot" [penwidth=1.5];
